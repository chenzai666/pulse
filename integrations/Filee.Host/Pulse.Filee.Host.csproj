<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Pulse.Filee.Host</AssemblyName>
    <RootNamespace>Pulse.FileConversion</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <FileeSourceRoot Condition="'$(FileeSourceRoot)' == ''">../src</FileeSourceRoot>
    <PublishTrimmed>false</PublishTrimmed>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <ProjectReference Include="$(FileeSourceRoot)/Filee.Core/Filee.Core.csproj" />
    <ProjectReference Include="$(FileeSourceRoot)/Filee.Engines/Filee.Engines.csproj" />
  </ItemGroup>
</Project>
